```
rpm -qa bind-*
yum install bind-* -y
set DNS servers as the machine itself
set hostname as srv1.bwu.com
cd /etc/named
cp named.conf named.conf.bak
vim named.conf
listen-on port 53 { 127.0.0.1; 192.168.10.1; };
allow-query  { localhost; any; };
zone "bwu.com" IN {
	type master;
	file "bwu.com.zone";
	allow-update { none; };
}

zone "10.168.192.in-addr.arpa" IN {
	type master;
	file "reverse.zone";
	allow-update { none; };
}
cd /var/named/
cp named.localhost bwu.com.zone
cp named.loopback reverse.zone
chgrp named bwu.com.zone
vim bwu.com.zone
@ IN SOA bwu.com. root.bwu.com. (
@ NS srv1.bwu.com.
srv1 A 192.168.10.1
cl1 A 192.168.10.101
vim reverse.zone
@ IN SOA srv1.bwu.com. root.bwu.com. (
@ NS srv1.bwu.com.
1 PTR srv1.
101 PTR cl1.

systemctl start named.service
